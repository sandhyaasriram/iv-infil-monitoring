#include <Arduino.h>
#include <math.h>
#include "model_params.h" // Generated by export_edge_model.py

#define LED_PIN 2

// Timing
unsigned long lastSerialTime = 0;
const unsigned long SERIAL_TIMEOUT_MS = 3000; 
unsigned long lastReplayTime = 0;
const unsigned long REPLAY_INTERVAL_MS = 1000; // 1 Hz

// State
float temp_history[WINDOW_SIZE];
float press_history[WINDOW_SIZE];
int history_idx = 0;
bool history_full = false;

String current_condition = "normal";

// A small internal fallback trace for demo purposes
struct FallbackRow {
  float temp;
  float press;
  const char* cond;
};

const FallbackRow FALLBACK_TRACE[] = {
  {32.8, 750, "normal"}, {32.8, 752, "normal"}, {32.9, 749, "normal"}, {32.9, 755, "normal"},
  {33.0, 760, "early"}, {33.1, 765, "early"}, {33.2, 770, "early"}, {33.3, 780, "early"},
  {33.5, 800, "moderate"}, {33.7, 850, "moderate"}, {33.9, 900, "moderate"}, {34.1, 950, "moderate"},
  {34.5, 1200, "severe"}, {34.8, 1500, "severe"}, {35.0, 1800, "severe"}, {35.2, 2000, "severe"}
};
const int NUM_FALLBACK = sizeof(FALLBACK_TRACE) / sizeof(FALLBACK_TRACE[0]);
int fallback_idx = 0;

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  
  for(int i=0; i<WINDOW_SIZE; i++) {
    temp_history[i] = NAN;
    press_history[i] = NAN;
  }
}

void extract_stats(float* win, int offset, float* features) {
  float sum = 0; int count = 0;
  float min_val = 1e9, max_val = -1e9;
  
  for(int i=0; i<WINDOW_SIZE; i++) {
    if(!isnan(win[i])) {
      sum += win[i];
      count++;
      if(win[i] < min_val) min_val = win[i];
      if(win[i] > max_val) max_val = win[i];
    }
  }
  
  if(count == 0) {
    features[offset + 0] = IMPUTER_MEAN[offset + 0];
    features[offset + 1] = IMPUTER_MEAN[offset + 1];
    features[offset + 2] = IMPUTER_MEAN[offset + 2];
    features[offset + 3] = IMPUTER_MEAN[offset + 3];
    features[offset + 4] = IMPUTER_MEAN[offset + 4];
    features[10 + offset/5] = 1.0; // missing flag
  } else {
    float mean_val = sum / count;
    features[offset + 0] = mean_val;
    features[offset + 3] = min_val;
    features[offset + 4] = max_val;
    features[10 + offset/5] = 0.0;
    
    float sum_sq = 0;
    float sum_xy = 0;
    float sum_y = 0;
    for(int i=0; i<WINDOW_SIZE; i++) {
      float val = isnan(win[i]) ? mean_val : win[i];
      float diff = val - mean_val;
      sum_sq += diff * diff;
      sum_xy += i * val;
      sum_y += val;
    }
    features[offset + 1] = sqrt(sum_sq / WINDOW_SIZE);
    
    float sum_x = (WINDOW_SIZE * (WINDOW_SIZE - 1)) / 2.0;
    float sum_x2 = (WINDOW_SIZE - 1) * WINDOW_SIZE * (2 * WINDOW_SIZE - 1) / 6.0;
    float denom = WINDOW_SIZE * sum_x2 - sum_x * sum_x;
    features[offset + 2] = (WINDOW_SIZE * sum_xy - sum_x * sum_y) / denom;
  }
}

void process_inference(float t_val, float p_val, String condition) {
  // Update history
  temp_history[history_idx] = t_val;
  press_history[history_idx] = p_val;
  history_idx = (history_idx + 1) % WINDOW_SIZE;
  if(history_idx == 0) history_full = true;
  
  // Need full window or pad it initially. We'll just run it anyway (stats handle NaNs)
  // Actually, for a ring buffer, we need to read in order. To keep it simple, we just pass the array as is.
  // The polyfit depends on order, so we should reorder it:
  float t_ordered[WINDOW_SIZE];
  float p_ordered[WINDOW_SIZE];
  for(int i=0; i<WINDOW_SIZE; i++) {
    int idx = (history_idx + i) % WINDOW_SIZE;
    t_ordered[i] = temp_history[idx];
    p_ordered[i] = press_history[idx];
  }
  
  float features[NUM_FEATURES];
  extract_stats(t_ordered, 0, features); // temp stats (0-4), missing_temp (10)
  extract_stats(p_ordered, 5, features); // press stats (5-9), missing_press (11)
  
  // Scale
  for(int i=0; i<NUM_FEATURES; i++) {
    features[i] = (features[i] - SCALER_MEAN[i]) / SCALER_SCALE[i];
  }
  
  // LogReg Softmax
  float z[4]; // 4 classes
  float sum_exp = 0;
  for(int i=0; i<NUM_CLASSES; i++) {
    z[i] = LOGREG_INTERCEPT[i];
    for(int j=0; j<NUM_FEATURES; j++) {
      z[i] += LOGREG_COEF[i][j] * features[j];
    }
    z[i] = exp(z[i]);
    sum_exp += z[i];
  }
  
  float prob_inf = 1.0 - (z[0] / sum_exp); // 1 - prob(none)
  
  int severity = 0;
  float max_prob = -1;
  for(int i=0; i<NUM_CLASSES; i++) {
    float p = z[i] / sum_exp;
    if(p > max_prob) {
      max_prob = p;
      severity = i;
    }
  }
  
  int alert = (severity > 1) ? 1 : 0; // moderate or severe
  digitalWrite(LED_PIN, alert ? HIGH : LOW);
  
  // Canonical Output: time_ms,temperature_c,pressure_adc,condition,probability,severity_class,alert
  unsigned long now = millis();
  Serial.print(now);
  Serial.print(",");
  if(isnan(t_val)) Serial.print("NaN"); else Serial.print(t_val, 3);
  Serial.print(",");
  if(isnan(p_val)) Serial.print("NaN"); else Serial.print(p_val, 1);
  Serial.print(",");
  Serial.print(condition);
  Serial.print(",");
  Serial.print(prob_inf, 4);
  Serial.print(",");
  Serial.print(severity);
  Serial.print(",");
  Serial.println(alert);
}

void loop() {
  if (Serial.available()) {
    String line = Serial.readStringUntil('\n');
    line.trim();
    if(line.length() > 0) {
      lastSerialTime = millis();
      
      int firstComma = line.indexOf(',');
      int secondComma = line.indexOf(',', firstComma + 1);
      
      if(firstComma > 0 && secondComma > 0) {
        String t_str = line.substring(0, firstComma);
        String p_str = line.substring(firstComma + 1, secondComma);
        String cond = line.substring(secondComma + 1);
        
        float t_val = (t_str == "NaN" || t_str == "nan") ? NAN : t_str.toFloat();
        float p_val = (p_str == "NaN" || p_str == "nan") ? NAN : p_str.toFloat();
        
        process_inference(t_val, p_val, cond);
      }
    }
  } else {
    // Fallback Replay
    if (millis() - lastSerialTime > SERIAL_TIMEOUT_MS) {
      if (millis() - lastReplayTime > REPLAY_INTERVAL_MS) {
        lastReplayTime = millis();
        
        FallbackRow r = FALLBACK_TRACE[fallback_idx];
        process_inference(r.temp, r.press, r.cond);
        
        fallback_idx = (fallback_idx + 1) % NUM_FALLBACK;
      }
    }
  }
}